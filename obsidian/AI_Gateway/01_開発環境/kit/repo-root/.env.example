# 名前だけの雛形（値は .env に書く・.env はコミットしない）
# 設計の正典: 開発環境構築ドキュメント §6

# --- Vertex / GCP ---
VERTEX_PROJECT=

# --- LiteLLM ---
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
LITELLM_VIRTUAL_KEY=

# --- Postgres (db) ---
POSTGRES_PASSWORD=
DATABASE_URL=

# --- Redis（有効化時のみ・litellm_config.yaml の該当コメントも外す） ---
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=
