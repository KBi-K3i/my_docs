# 雛形（これを .env に写す。.env はコミットしない）
# 設定もれ防止のため、ラボでそのまま動くダミー初期値を入れてある。
# 実値への差し替えが要るのは「LLMプロバイダ」節だけ。

# --- LLMプロバイダ（入れ替え可能。使うものだけ設定） ---
# [Vertex AI] GCPプロジェクトID と、secrets/ に置いた認証JSONのパス（SA鍵でもADCでも可）
VERTEX_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/secrets/application_default_credentials.json
# [OpenAI に替える場合] 上2行の代わりに下を設定し、litellm_config.yaml の model_list を差し替える
# OPENAI_API_KEY=sk-...

# --- LiteLLM ---
LITELLM_MASTER_KEY=sk-dummy-master-key-0000
# 一度 DB に保存が始まったら変えない（変えると復号不能）
LITELLM_SALT_KEY=sk-dummy-salt-key-0000
# 仮想キー発行までは master key と同値でよい
LITELLM_VIRTUAL_KEY=sk-dummy-master-key-0000

# --- gateway → LiteLLM 接続先（この構成は LB 経由の1本） ---
LITELLM_BASE_URL=http://litellm-lb:4000

# --- Postgres (db) ---
POSTGRES_PASSWORD=dummy-litellm-pw
# パスワード部は POSTGRES_PASSWORD と同じ値を埋め込む
DATABASE_URL=postgresql://litellm:dummy-litellm-pw@db:5432/litellm

# --- Redis（この構成は既定で使用） ---
REDIS_HOST=redis
REDIS_PORT=6379
# REDIS_PASSWORD=   # ラボは内部NW専用なので未設定（本番では必須）
